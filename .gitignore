# Adapted from sum-app, before any code exists, so that nothing private can
# reach this public repository by accident.

# Compiled binaries, named after the module in the repository root.
/reconcile-checks
/reconcile-checks-*
*.exe
*.test
*.out
*.prof
coverage.*

# A register holds real checks: payees, amounts, memos. The real one lives
# under ~/.local/share/reconcile-checks/, but a copy must never land here.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Configuration and keys. The example config is tracked and is the
# documentation; a real one never is.
config.toml
!config.example.toml
key
*.key
*.pem
*.env
.env*

# A check printed or rendered from real data, and scans of real stock, whose
# MICR line carries the full account and routing numbers. Golden test images
# of invented checks are tracked under testdata/ on purpose.
*.pdf
*.png
*.jpg
*.jpeg
!**/testdata/**/*.png
exports/

# Local tooling (the pinned Typst lands in ./tools) and editor state
/tools/
.idea/
.vscode/
*.swp
.DS_Store

# Claude Code working state. CLAUDE.md and settings.json are tracked on
# purpose; they are how the project is built. The rest is not.
.claude/worktrees/
.claude/settings.local.json
