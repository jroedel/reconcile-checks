#!/usr/bin/env bash
#
# run — the self-update test, end to end (docs/10-install-update-and-releases.md).
#
# Builds real reconcile-checks binaries from this tree with a throwaway
# release key, stands up something that answers as GitHub with a release
# signed by that key, and puts one computer at a time in front of it, in
# Docker, on a network with no way out to the internet.
#
#     scripts/selfupdate-e2e/run                     # every case
#     scripts/selfupdate-e2e/run happy app-restart   # only these
#     scripts/selfupdate-e2e/run --list              # what there is
#
# THE UPGRADE GATE (the release workflow, docs/10):
#
#     scripts/selfupdate-e2e/run --previous OLD --candidate NEW --key KEY
#
# installs OLD, the previous published release as it was downloaded, and
# offers NEW, the binary about to be published, signed with KEY (the base64
# of the release key's private half, in a file). Only the happy and the
# app-restart cases: the previous release, unchanged, must update itself to
# the candidate both by `update` and by itself while running. The release
# key, not a throwaway one, because the previous release trusts nothing else.
#
# WHAT THIS PROVES, AND WHAT IT DOES NOT
#
# That the program, doing real DNS and real TLS against a release it can't
# tell from GitHub's:
#   - installs a good release, and restarts into it by itself while running;
#   - refuses every broken, unsigned or wrongly signed release and leaves the
#     computer on the version it started with;
#   - puts the previous version back when the new one doesn't come up at the
#     restart, or keeps failing to start afterwards, and won't install it again.
#
# Not: Windows (its renames, Defender, SmartScreen), which is the Windows job
# in CI and a person's check (docs/10, "Testing on Windows"); the browser tab
# reconnecting; or a computer that has run the previous release for a month.
#
# Never the real GitHub, and never the release key: the key is made here, for
# this run, and thrown away with it.

set -euo pipefail

cd "$(dirname "$0")/../.."

IMAGE=reconcile-checks-selfupdate-e2e
NETWORK=reconcile-checks-selfupdate-e2e
CURRENT_VERSION=v9.9.8
NEXT_VERSION=v9.9.9

# ---------------------------------------------------------------------------
# The cases. Fields:
#
#   name | fault | offered | expectation | environment...
#
# offered is what the release serves as reconcile-checks-linux-amd64:
#   next    a good build stamped $NEXT_VERSION
#   stale   a good build stamped $CURRENT_VERSION, offered as $NEXT_VERSION
#   hang    a build that answers `version` and then never comes up
#   crash   a build that answers `version`, keeps probation, and then dies
#
# CURRENT_KIND is what the computer starts with: stale (the default, a good
# $CURRENT_VERSION), nokey (the same, built without a key), next, or dev.
# ---------------------------------------------------------------------------

CASES=(
  # -- `reconcile-checks update`: the release is right.
  "happy|none|next|updated|"

  # -- The release is wrong. Each must leave the computer alone.
  "wrong-hash|wrong-hash|next|refused|"
  "truncated|truncated|next|refused|"
  "corrupt-mid|corrupt-mid|next|refused|"
  "no-sums|no-sums|next|refused|"
  "no-sig|no-sig|next|refused|"
  "bad-sig|bad-sig|next|refused|"
  "other-key|other-key|next|refused|"
  "no-asset|no-asset|next|refused|"
  "prerelease|prerelease|next|refused|"
  "draft|draft|next|refused|"
  "rate-limited|rate-limited|next|refused|"
  "hangup|hangup|next|refused|"
  "version-lie|none|stale|refused|"

  # -- The computer is the variable.
  "no-key|none|next|no-key|CURRENT_KIND=nokey"
  "already-current|none|next|nothing-to-do|CURRENT_KIND=next CURRENT_VERSION=$NEXT_VERSION"
  "downgrade|none|next|nothing-to-do|CURRENT_KIND=next CURRENT_VERSION=$NEXT_VERSION OFFER_TAG=v9.9.7"
  "dev-build|none|next|nothing-to-do|CURRENT_KIND=dev CURRENT_VERSION=dev"
  "not-writable|none|next|not-writable|INSTALL_DIR=/opt/reconcile-checks INSTALL_OWNER=root"

  # -- The program running, as a person uses it: it checks at start,
  #    installs, and restarts into the new version by itself.
  "app-restart|none|next|app-updated|"
  "app-restart-hangs|none|hang|app-rolled-back|"
  "update-now|none|next|update-now|"
  "first-run|none|next|first-run|CURRENT_KIND=next CURRENT_VERSION=$NEXT_VERSION"

  # -- A version that installs, starts, and keeps failing: probation gives
  #    up on it at the fourth start.
  "probation|none|crash|probation-rolled-back|"
)

PREVIOUS=""
CANDIDATE=""
KEYFILE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --previous)  PREVIOUS="$2"; shift 2 ;;
    --candidate) CANDIDATE="$2"; shift 2 ;;
    --key)       KEYFILE="$2"; shift 2 ;;
    *) break ;;
  esac
done

if [ -n "$PREVIOUS$CANDIDATE$KEYFILE" ]; then
  [ -f "$PREVIOUS" ] && [ -f "$CANDIDATE" ] && [ -f "$KEYFILE" ] || {
    echo "run: --previous, --candidate and --key each name a file" >&2
    exit 2
  }

  # Their own words for their versions: the second word of `version`.
  CURRENT_VERSION=$("$PREVIOUS" version | awk '{print $2}')
  NEXT_VERSION=$("$CANDIDATE" version | awk '{print $2}')
  set -- happy app-restart
fi

case "${1:-}" in
  --list|-l)
    for c in "${CASES[@]}"; do printf '%s\n' "${c%%|*}"; done
    exit 0
    ;;
  -h|--help)
    sed -n '2,30p' "$0" | sed 's/^#\{0,1\} \{0,1\}//'
    exit 0
    ;;
esac

WANTED=("$@")

wanted() {
  [ ${#WANTED[@]} -eq 0 ] && return 0

  local w
  for w in "${WANTED[@]}"; do [ "$w" = "$1" ] && return 0; done

  return 1
}

WORK="$(mktemp -d)"

# The containers first, then anything else on the network, then the network:
# an interrupted run leaves one attached, and the next run would fail with
# "network already exists".
teardown() {
  docker rm -f "$NETWORK-server" "$NETWORK-case" >/dev/null 2>&1 || true

  local held
  held=$(docker ps -aq --filter "network=$NETWORK" 2>/dev/null || true)

  if [ -n "$held" ]; then
    # shellcheck disable=SC2086  # a list of ids, split on purpose
    docker rm -f $held >/dev/null 2>&1 || true
  fi

  docker network rm "$NETWORK" >/dev/null 2>&1 || true
}

cleanup() {
  teardown
  rm -rf "$WORK"
}

trap cleanup EXIT

echo "==> building"

mkdir -p "$WORK/bin" "$WORK/ctx" "$WORK/in" "$WORK/assets" "$WORK/key"

GO="${GO:-go}"

# Static, as a release is.
build() { # out version package [more ldflags]
  CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    "$GO" build -trimpath -ldflags "-s -w -X main.version=$2 ${4:-}" -o "$1" "$3"
}

build "$WORK/ctx/releaseserver" "" ./scripts/selfupdate-e2e/releaseserver

if [ -n "$PREVIOUS" ]; then
  # The upgrade gate: the binaries as they are, and the real key.
  cp "$PREVIOUS" "$WORK/bin/stale"
  cp "$CANDIDATE" "$WORK/bin/next"
  install -m 0600 "$KEYFILE" "$WORK/key/key.priv"
else
  "$WORK/ctx/releaseserver" -keygen "$WORK/key"

  KEY="-X main.releaseKey=$(cat "$WORK/key/key.pub")"

  build "$WORK/bin/next"  "$NEXT_VERSION"    ./cmd/reconcile-checks "$KEY"
  build "$WORK/bin/stale" "$CURRENT_VERSION" ./cmd/reconcile-checks "$KEY"
  build "$WORK/bin/nokey" "$CURRENT_VERSION" ./cmd/reconcile-checks
  build "$WORK/bin/dev"   "dev"              ./cmd/reconcile-checks "$KEY"
  build "$WORK/bin/hang"  "$NEXT_VERSION"    ./scripts/selfupdate-e2e/brokenbuild "-X main.mode=hang"
  build "$WORK/bin/crash" "$NEXT_VERSION"    ./scripts/selfupdate-e2e/brokenbuild "-X main.mode=crash"
fi

cp scripts/selfupdate-e2e/{Dockerfile,run-case} "$WORK/ctx/"

# Appended rather than kept in the Dockerfile, which would otherwise COPY a
# file the repository doesn't contain.
cat >>"$WORK/ctx/Dockerfile" <<'DOCKER'

# Built by ../run into the context: it serves the fake release, from inside
# the network, under the names the program under test resolves.
COPY releaseserver /harness/releaseserver
DOCKER

docker build -q -t "$IMAGE" "$WORK/ctx" >/dev/null

teardown

# --internal: nothing on this network reaches the internet, so the program
# under test can't reach the real GitHub whatever it does.
docker network create --internal "$NETWORK" >/dev/null

passed=0
failed=0
skipped=0
failures=()

for spec in "${CASES[@]}"; do
  IFS='|' read -r name fault offered expect environment <<<"$spec"

  if ! wanted "$name"; then
    skipped=$((skipped + 1))
    continue
  fi

  CASE_CURRENT="$CURRENT_VERSION"
  CASE_NEXT="$NEXT_VERSION"
  CURRENT_KIND=stale
  OFFER_TAG=""
  INSTALL_DIR=""
  INSTALL_OWNER=""

  if [ -n "$environment" ]; then
    for assignment in $environment; do
      case "$assignment" in
        CURRENT_VERSION=*) CASE_CURRENT="${assignment#*=}" ;;
        NEXT_VERSION=*)    CASE_NEXT="${assignment#*=}" ;;
        *)                 declare "${assignment%%=*}=${assignment#*=}" ;;
      esac
    done
  fi

  tag="${OFFER_TAG:-$CASE_NEXT}"

  printf '\n==> %s  (fault: %s, offers: %s as %s, expects: %s)\n' "$name" "$fault" "$offered" "$tag" "$expect"

  rm -f "$WORK/assets"/* "$WORK/in"/*
  cp "$WORK/bin/$offered" "$WORK/assets/reconcile-checks-linux-amd64"
  cp "$WORK/bin/$CURRENT_KIND" "$WORK/in/current"

  docker rm -f "$NETWORK-server" >/dev/null 2>&1 || true

  # Docker's own DNS answers a network alias before anything else, so the
  # program looks up api.github.com and github.com and gets this.
  docker run -d --name "$NETWORK-server" \
    --network "$NETWORK" \
    --network-alias api.github.com \
    --network-alias github.com \
    --network-alias objects.githubusercontent.com \
    -v "$WORK/assets:/assets:ro" \
    -v "$WORK/key:/key:ro" \
    -v "$WORK/in:/out" \
    --entrypoint /harness/releaseserver \
    "$IMAGE" \
      -addr :443 -assets /assets -key /key/key.priv \
      -tag "$tag" -fault "$fault" \
      -ca-out /out/ca.pem -ready /out/ready >/dev/null

  for _ in $(seq 1 100); do
    [ -f "$WORK/in/ready" ] && break
    sleep 0.1
  done

  if [ ! -f "$WORK/in/ready" ]; then
    echo "      FAIL the release server never came up"
    docker logs "$NETWORK-server" 2>&1 | sed 's/^/      | /'
    failed=$((failed + 1))
    failures+=("$name")
    continue
  fi

  if docker run --rm --name "$NETWORK-case" --network "$NETWORK" \
    -v "$WORK/in:/in:ro" \
    -e "CURRENT_VERSION=$CASE_CURRENT" \
    -e "NEXT_VERSION=$CASE_NEXT" \
    -e "EXPECT=$expect" \
    ${INSTALL_DIR:+-e "INSTALL_DIR=$INSTALL_DIR"} \
    ${INSTALL_OWNER:+-e "INSTALL_OWNER=$INSTALL_OWNER"} \
    "$IMAGE"
  then
    passed=$((passed + 1))
  else
    failed=$((failed + 1))
    failures+=("$name")
    docker logs "$NETWORK-server" 2>&1 | tail -20 | sed 's/^/      server | /'
  fi

  docker rm -f "$NETWORK-server" >/dev/null 2>&1 || true
done

printf '\n==> %d passed, %d failed' "$passed" "$failed"
[ "$skipped" -gt 0 ] && printf ', %d not run' "$skipped"
printf '\n'

if [ "$failed" -gt 0 ]; then
  printf '    %s\n' "${failures[@]}"
  exit 1
fi
